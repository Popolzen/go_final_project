# ================================
# Server
# ================================

# HTTP server address
SERVER_ADDRESS=:8080

# Enable HTTPS (true / false)
ENABLE_HTTPS=false

# TLS certificate paths (required if ENABLE_HTTPS=true)
CERT_FILE=/path/to/cert.pem
KEY_FILE=/path/to/key.pem


# ================================
# Database
# ================================

# PostgreSQL DSN
DATABASE_DSN=postgres://postgres:password@localhost:5432/gophkeeper?sslmode=disable


# ================================
# Security
# ================================

# JWT signing secret
JWT_SECRET=change-me-in-production

# Encryption key (32 bytes, AES-256)
# Example: openssl rand -hex 32
ENCRYPT_KEY=0123456789abcdef0123456789abcdef
